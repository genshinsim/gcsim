{
	"name": "gcsim-gateway",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-12",
	// Bundle the card's TTF bytes as raw ArrayBuffers (see preview/cardFonts.ts).
	"rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	},
	// ASSET_SOURCE_HOSTS (per-type ordered mihoyo source hosts, JSON) is managed
	// in the Cloudflare dashboard, not here. The deploy uses --keep-vars so it is
	// not wiped; if unset the worker falls back to hardcoded mihoyo defaults.
	// OG_PREVIEW_SCALE (OG card supersample factor, number; clamped to [1,3]) is
	// likewise dashboard-managed and preserved via --keep-vars; if unset/invalid
	// the worker falls back to a default of 1.5.
	// OG_PREVIEW_CACHE_REV (OG edge-cache revision, integer) is also
	// dashboard-managed and preserved via --keep-vars; bump it to force cards to
	// re-render (e.g. after changing OG_PREVIEW_SCALE). If unset/invalid the
	// worker falls back to a default of 1.
	"r2_buckets": [
		{
			"binding": "GCSIM_WASM",
			"bucket_name": "wasm"
		},
		{
			"binding": "GCSIM_ASSETS",
			"bucket_name": "gcsim"
		}
	],
	"env": {
		"staging": {
			"workers_dev": true,
			// Bindings are not inherited across wrangler environments, so the
			// assets binding and r2 buckets must be redeclared here verbatim.
			"assets": {
				"directory": "../web/dist",
				"binding": "ASSETS",
				"run_worker_first": true,
				"not_found_handling": "single-page-application"
			},
			"r2_buckets": [
				{
					"binding": "GCSIM_WASM",
					"bucket_name": "wasm"
				},
				{
					"binding": "GCSIM_ASSETS",
					"bucket_name": "gcsim"
				}
			]
		}
	}
}
