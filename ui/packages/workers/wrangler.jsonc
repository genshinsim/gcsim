{
	"name": "gcsim-gateway",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-12",
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "single-page-application"
	},
	"r2_buckets": [
		{
			"binding": "GCSIM_WASM",
			"bucket_name": "wasm"
		}
	]
}
