{
	"extends": "../../tsconfig.json",
	"include": ["src", "src/**/*.json"],
	"compilerOptions": {
		"baseUrl": "./",
		// Storybook 10 ships its APIs behind package `exports` subpaths (e.g.
		// `storybook/test`), which the root config's classic "Node" resolution
		// cannot read. "Bundler" matches how Vite resolves these at build time.
		"moduleResolution": "Bundler",
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
