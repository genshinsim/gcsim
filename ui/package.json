{
	"name": "gcsim",
	"packageManager": "pnpm@11.5.1",
	"private": true,
	"scripts": {
		"clean": "pnpm store prune && rimraf node_modules",
		"lint": "biome check .",
		"format": "biome check --write .",
		"circular": "madge --circular --extensions ts ./",
		"orphans": "madge --orphans --extensions ts ./",
		"list-deps": "syncpack list",
		"list-mismatches": "syncpack list-mismatches",
		"fix-mismatches": "syncpack fix-mismatches",
		"start": "concurrently \"pnpm:start:watch-wasm\" \"pnpm:start:web\"",
		"start:watch-wasm": "pnpm --filter @gcsim/executors watch:web",
		"start:web": "pnpm --filter @gcsim/web dev",
		"start:embed": "pnpm --filter @gcsim/embed dev",
		"start:db": "pnpm --filter @gcsim/db dev",
		"start:docs": "pnpm --filter @gcsim/docs start",
		"start:taghelper": "pnpm --filter @gcsim/taghelper dev",
		"preview": "pnpm run preview:web",
		"preview:web": "pnpm --filter @gcsim/web preview",
		"preview:embed": "pnpm --filter @gcsim/embed preview",
		"build": "pnpm run build:wasm && pnpm run build:web",
		"build:wasm": "pnpm --filter @gcsim/executors build:wasm:web",
		"build:web": "pnpm --filter @gcsim/web build",
		"build:embed": "pnpm --filter @gcsim/embed build",
		"build:db": "pnpm --filter @gcsim/db build",
		"build:docs": "pnpm --filter @gcsim/docs build",
		"build:taghelper": "pnpm --filter @gcsim/taghelper build",
		"deploy:workers": "pnpm --filter @gcsim/workers deploy",
		"start:workers": "pnpm --filter @gcsim/workers start",
		"storybook": "pnpm --filter @gcsim/storybook storybook"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/git-rev-sync": "^2.0.0",
		"@types/react": "^18.0.21",
		"@types/react-dom": "^18.0.6",
		"@types/rimraf": "^3",
		"@types/watch": "^1",
		"autoprefixer": "^10.4.12",
		"concurrently": "^7.5.0",
		"genshin-db": "^4.3.14",
		"madge": "^6.0.0",
		"postcss": "^8.4.18",
		"protobufjs": "^7.1.2",
		"protobufjs-cli": "^1.1.1",
		"rimraf": "^3.0.2",
		"syncpack": "^8.2.4",
		"tailwindcss": "^3.2.1",
		"ts-proto": "^1.170.0",
		"typescript": "^4.8.4",
		"watch": "^1.0.2"
	}
}
